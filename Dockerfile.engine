FROM alpine:3.22 AS guac-builder

WORKDIR /src

COPY scripts/build-engine-release.sh ./scripts/build-engine-release.sh
RUN sh scripts/build-engine-release.sh deps-guac

COPY vendor/guacamole-server/ ./vendor/guacamole-server/

RUN sh scripts/build-engine-release.sh guac


FROM alpine:3.22 AS engine-builder

WORKDIR /src

COPY scripts/build-engine-release.sh ./scripts/build-engine-release.sh
RUN sh scripts/build-engine-release.sh deps-engine

RUN sh scripts/build-engine-release.sh deps-webview

ARG VERSION

COPY --from=guac-builder /src/vendor/guacamole-server/dist/ ./vendor/guacamole-server/dist/
COPY schema/ ./schema/
COPY engine/ ./engine/

RUN if [ -n "$VERSION" ]; then \
        sed -i "s/^#define NEXTERM_ENGINE_VERSION \".*\"/#define NEXTERM_ENGINE_VERSION \"$VERSION\"/" engine/src/proto/control_plane.h; \
    fi

RUN sh scripts/build-engine-release.sh engine

FROM alpine:3.22 AS mesa-builder

RUN apk add --no-cache \
    bison build-base expat-dev flex libdrm-dev libx11-dev libxdamage-dev \
    libxext-dev libxfixes-dev libxrandr-dev libxshmfence-dev libxxf86vm-dev \
    meson ninja py3-mako py3-packaging py3-yaml python3 xorgproto \
    zlib-dev zstd-dev

ARG MESA_VERSION=25.1.9
ARG MESA_SHA256=412df33a1bb3c785ed698555a3972118a37c458e7accf6ae53f4bb87b3db454a

RUN wget -q "https://archive.mesa3d.org/mesa-${MESA_VERSION}.tar.xz" \
    && echo "${MESA_SHA256}  mesa-${MESA_VERSION}.tar.xz" | sha256sum -c - \
    && tar xf "mesa-${MESA_VERSION}.tar.xz"

WORKDIR /mesa-${MESA_VERSION}

RUN meson setup build \
    --prefix=/usr/local \
    --buildtype=release \
    -Dllvm=disabled \
    -Dgallium-drivers=softpipe \
    -Dvulkan-drivers= \
    -Dplatforms=x11 \
    -Dglx=dri \
    -Degl=enabled \
    -Dgles1=disabled \
    -Dgles2=enabled \
    -Dgbm=enabled \
    -Dshared-glapi=enabled \
    -Dgallium-extra-hud=false \
    -Dbuild-tests=false \
    && ninja -C build \
    && ninja -C build install \
    && rm -rf /usr/local/lib/pkgconfig /usr/local/include /usr/local/share


FROM alpine:3.22 AS libvnc-builder

WORKDIR /src

COPY scripts/build-engine-release.sh ./scripts/build-engine-release.sh
RUN sh scripts/build-engine-release.sh deps-libvnc

COPY vendor/patches/ ./vendor/patches/
RUN sh scripts/build-engine-release.sh libvnc

FROM alpine:3.22

RUN apk add --no-cache \
    cairo jpeg libpng ossp-uuid libuuid \
    pango libwebp openssl \
    libpulse libvorbis libogg libssh2 \
    libvncserver freerdp-libs libcurl

COPY scripts/install-browser-runtime.sh /tmp/install-browser-runtime.sh
RUN sh /tmp/install-browser-runtime.sh && rm -f /tmp/install-browser-runtime.sh

COPY --from=mesa-builder /usr/local/lib/ /usr/lib/

COPY --from=libvnc-builder /src/vendor/libvncserver/dist/lib/libvncclient.so.1 /usr/lib/

COPY --from=guac-builder /src/vendor/guacamole-server/dist/lib/ /usr/local/lib/

COPY --from=engine-builder /src/engine/build/nexterm-engine /usr/local/bin/nexterm-engine
COPY --from=engine-builder /src/engine/build/nexterm-webview /usr/local/bin/nexterm-webview

RUN cp /usr/local/lib/freerdp3/*.so /usr/lib/freerdp3/ \
    && ldconfig /usr/lib /usr/local/lib 2>/dev/null || true

ENV LOG_LEVEL=info

WORKDIR /etc/nexterm

ENTRYPOINT ["nexterm-engine"]
