Complete the text-only Extended Clipboard handshake with TigerVNC.
Based on LibVNCServer 0.9.15; retain the existing screen-ID-zero patch.
Reply to capabilities, request announced UTF-8 text, and strip the wire NUL.
Do not advertise unimplemented Request/Peek handlers.

--- a/src/libvncclient/rfbclient.c
+++ b/src/libvncclient/rfbclient.c
@@ -1924,6 +1924,22 @@
  */
 
 static rfbBool
+sendExtClientClipboardControl(rfbClient* client, uint32_t flags, rfbBool caps)
+{
+  rfbClientCutTextMsg msg;
+  uint32_t payload[2];
+  unsigned int length = caps ? sizeof(payload) : sizeof(payload[0]);
+  memset(&msg, 0, sizeof(msg));
+  msg.type = rfbClientCutText;
+  msg.length = rfbClientSwap32IfLE(-(int32_t)length);
+  payload[0] = rfbClientSwap32IfLE(flags);
+  /* Maximum unsolicited UTF-8 payload. One size follows the one type. */
+  payload[1] = rfbClientSwap32IfLE(1 << 20);
+  return WriteToRFBServer(client, (char*)&msg, sz_rfbClientCutTextMsg)
+      && WriteToRFBServer(client, (char*)payload, length);
+}
